# Environment configuration for WLT-AdBlocker local builds & signing
# Copy to .env (or configure android/local.properties) — never commit secrets.

# Path to Android SDK (alternative to sdk.dir in android/local.properties)
ANDROID_HOME=

# Path to Android NDK (required only when rebuilding wlt.aar via gomobile bind)
ANDROID_NDK_HOME=

# Optional Android release signing configuration (keep empty for debug builds)
WLT_KEYSTORE_PATH=
WLT_KEYSTORE_PASSWORD=
WLT_KEY_ALIAS=
WLT_KEY_PASSWORD=
