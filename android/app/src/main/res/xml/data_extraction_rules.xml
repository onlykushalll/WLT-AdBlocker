<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ device-to-device transfer rules. Same privacy posture as
     backup_rules.xml: nothing is transferred automatically. Users who
     want to migrate settings must export to JSON and import on the new
     device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
