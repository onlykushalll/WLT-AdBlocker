<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================= -->
    <!-- NETWORK PERMISSIONS                            -->
    <!-- ============================================= -->
    <!-- Full network access for forwarding DNS queries upstream -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Change network state for advanced connectivity management -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Access fine/coarse location for advanced network attribution (WiFi SSID → app) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ============================================= -->
    <!-- FOREGROUND SERVICE PERMISSIONS                 -->
    <!-- ============================================= -->
    <!-- Foreground service for the VPN. specialUse subtype (API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIALUSE" />
    <!-- Alternative FGS types for broader Android version compatibility -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- ============================================= -->
    <!-- NOTIFICATION PERMISSIONS                       -->
    <!-- ============================================= -->
    <!-- Notifications (API 33+ runtime permission). Required for the VPN
         foreground notification to actually display on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WAKE_LOCK to keep VPN alive during device sleep -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ============================================= -->
    <!-- APP INSPECTION PERMISSIONS                     -->
    <!-- ============================================= -->
    <!-- QUERY_ALL_PACKAGES: required for the per-app firewall (we need to
         list every installed app so the user can toggle VPN bypass). This
         is a sensitive permission on Play Store; we sidestep that by
         distributing outside Play (F-Droid / direct APK). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- PACKAGE_USAGE_STATS: advanced per-app traffic attribution (requires
         user grant via Settings > Security > Usage Access). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- READ_PHONE_STATE for UID resolution on older Android (API < 30) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ============================================= -->
    <!-- SYSTEM INTEGRATION PERMISSIONS                 -->
    <!-- ============================================= -->
    <!-- Boot receiver (disabled by default; user must opt in via Settings). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Quick settings tile. -->
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <!-- Request ignore battery optimizations to keep VPN alive -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ============================================= -->
    <!-- STORAGE PERMISSIONS (for CA cert export)       -->
    <!-- ============================================= -->
    <!-- Legacy storage permission for CA cert export on pre-Q Android. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".WltApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WltAdblocker"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WltAdblocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VPN service. The system grants us BIND_VPN_SERVICE when the user
             accepts the system VPN dialog. foregroundServiceType=specialUse
             is required on API 34+ for any foreground service that isn't
             one of the standard types (dataSync/mediaLocation/etc.). -->
        <service
            android:name=".vpn.WltVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN ad blocking" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- HTTPS MITM proxy service (Phase 3, off by default). -->
        <service
            android:name=".vpn.HttpsProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="HTTPS MITM proxy for ad pruning" />
        </service>

        <!-- Quick settings tile. -->
        <service
            android:name=".WltTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Boot receiver — DISABLED by default for privacy. Enabled only
             if the user explicitly opts in via Settings. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for CA cert export. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
